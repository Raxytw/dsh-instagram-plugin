{
  "name": "@luoyi-dsh/instagram-plugin",
  "version": "1.0.7",
  "description": "DeepSeek Harness (DSH) Instagram 插件：背景標籤巡查推薦、被@提問上下文推理應答與私訊雙向互動",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "instagram",
    "mcp",
    "duty"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client.js",
    "cordis.patch.yml",
    "!**/data/**",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "dotenv": "^16.4.7",
    "@luoyi-dsh/instagram-mcp": "^1.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "cordis": "*"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "author": {
    "name": "Raxytw",
    "url": "https://github.com/Raxytw"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raxytw/dsh-instagram-plugin.git"
  },
  "private": false
}
